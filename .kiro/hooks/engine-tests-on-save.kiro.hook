{
  "enabled": true,
  "name": "Run tests when engine or lib changes",
  "description": "Runs npm test whenever a file under src/engine/ or src/lib/ is saved.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/engine/**/*.ts", "src/lib/**/*.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file under src/engine/ or src/lib/ was saved. Run `npm test` and report the result. Do not edit tests to make them pass."
  }
}
